# OpenArm カメラ系の USB 省電力を止める（2026-09-21・板橋）
#
# 症状: 新ハブ（GenesysLogic USB3.1 Hub 05e3:0626）配下の RealSense 3 台が、約 10 秒に 1 回・
#       3 台同時に約 1.2 秒フリーズ／wrist_left のストリームがエンドポイント停止で死ぬ。
# 原因: USB runtime suspend。しかも uvcvideo は probe のたびに usb_enable_autosuspend() を呼ぶので、
#       デバイス追加時に power/control=on にしても、librealsense がインタフェースを掴む/離すたび
#       （uvcvideo の再 probe）に auto へ戻る（D435i で 1 秒周期の再 probe を実測）。
# 対策: (1) デバイス追加時に on、(2) インタフェースが bind されるたび（uvcvideo/usbhid の probe 直後）
#       に親デバイスへ on を書き直す。ハブ（05e3:0626）・D435i（8086:0b3a）・D405（8086:0b5b）が対象。
# 導入: sudo cp udev/81-openarm-usb-nosuspend.rules /etc/udev/rules.d/ && sudo udevadm control --reload
#       && sudo udevadm trigger --subsystem-match=usb --action=add
# 確認: cat /sys/bus/usb/devices/<dev>/power/control -> on（しばらく待っても auto に戻らない）
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="05e3", ATTR{idProduct}=="0626", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="8086", ATTR{idProduct}=="0b3a", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="8086", ATTR{idProduct}=="0b5b", TEST=="power/control", ATTR{power/control}="on"
# PEAK PCAN-USB Pro FD（0c72:0011）と、その上流ハブ（Genesys 05e3:0610）も省電力を止める。
# 2026-09-21 20:09: follower 箱の USB flap → tegra-xusb "HC died"（全 USB 消失）。flap の一因を潰す。
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0c72", ATTR{idProduct}=="0011", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="05e3", ATTR{idProduct}=="0610", TEST=="power/control", ATTR{power/control}="on"
# インタフェースが bind されたら親（usb_device）を on に戻す（uvcvideo が auto に戻した直後に上書き）
ACTION=="bind|add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b3a", RUN+="/bin/sh -c 'echo on > /sys$devpath/../power/control'"
ACTION=="bind|add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b5b", RUN+="/bin/sh -c 'echo on > /sys$devpath/../power/control'"
