# タスク takeei_wood のタスクファイル（台帳 config/tasks/takeei_wood.yaml・確認は python3 scripts/task.py check takeei_wood）。
# 2026-10-28 に bimanual-collect.takeei_wood_l1.env から作った。変えたのは TASK_SLUG・POSE_SET・OPERATOR の 3 つだけで、下のコメントは元のまま。
# OPERATOR は空にしてある。録る人を毎回渡す（例 OPERATOR=Kota ENV_FILE=config/bimanual-collect.takeei_wood.env bash scripts/collect_bimanual.sh gate）。

# 両腕収集のセッション既定値: タケエイ仕分け 木材 レベル1（docs/takeei-material-level-collection.md）。
# scripts/collect_bimanual.sh が source する。物理条件は scenes/<SCENE>.yaml。
# TODO を残したままだと collect_bimanual.sh は起動を拒否する（dry は SCENE=none で通る）。
OPERATOR=
# 言語指示は種類ごとに固定し、レベルでは変えない（推論時に上位プログラムが渡す文と一致させる）
TASK="Pick up the wood and place it in the box"
TASK_SLUG=takeei_wood
SCENE=kitakyushu-wood-l1-v1
# カメラ（北九州・2026-10-19 実測。kitakyushu_takeei_sort.env と同じ）
CHEST_SERIAL=344422070898       # D435i
WRIST_RIGHT_SERIAL=352122273417 # D405
WRIST_LEFT_SERIAL=409122272149  # D405
WRIST_LEFT=true
D405_GAIN=16
D405_EXPOSURE=8000
D435_GAIN=64
D435_EXPOSURE=80
D435_BRIGHTNESS=
# エピソードは操作者が → で終える運用（2026-10-20 Kota。40 秒の自動終了では短かった）。
# 600 秒は押し忘れたときの安全上限で、通常はここまで行かない
EPISODE_TIME_S=600
LSCALE=1.0
RSCALE=1.0
GRIPPER_KP=12
ALIGN_GRAVITY=false
# 開始姿勢は前日の kitakyushu-takeei-v2 から引き継いだ draft（2026-10-20 作成）。
# 箱を正面奥に置くので、開始姿勢や経由地が箱に干渉しないか dry で目視する。
# draft のうちは record 起動時の照合でシーンの sha が自動で取り込まれ、最初の本番 run で凍結される。
POSE_SET=kitakyushu-takeei-v5
PLAY_SOUNDS=true
# 2026-10-19 に実機で調整した設定（openarm-episode-setup-2026-10-19.md §3）
# 2026-10-20 Kota の指示で一旦 off（重力補償のみ）。戻すときは true にする（下の左グリッパーのゲインは true のときだけ効く）
BILATERAL_FEEDBACK=false
L_BILATERAL_GRIPPER_KP=1.25
L_BILATERAL_GRIPPER_KD=0.06
# 2026-10-21 Kota の指示で、録画の終わらせ方で保存か破棄かを決め、そのまま開始姿勢へ戻す（a は不要）。
#   → 録画開始 / 録画中の → 保存して戻す / 録画中の ← 破棄して戻す / 戻り終わったら → で次を開始
# 保存は戻す前に済むので、録画を終えた後のハング・クラッシュでもテイクは残る。失敗は録画中に ← で捨てる。
RETURN_ON_EPISODE_END=true
SAVE_ON_EPISODE_END=false
# 2026-10-21 Kota の指示で、起動時の整列と開始姿勢への戻しを左右同時に動かす（左→右の順番待ちをなくす）。
# 左右の経路の干渉は確かめていないので、最初の dry で目視する。戻すときは false
PARALLEL_ARMS=true
# 2026-10-24: leader と follower も同時に動かす（PARALLEL_ARMS と合わせて 4 本同時）。最初の dry で目視。戻すときは false
PARALLEL_LEADER_FOLLOWER=true
# a の後と起動直後は、→ を押すまで両腕を開始姿勢で保持する（2026-10-20 dry で動作確認）。
# 開始姿勢の手首 J7 は leader が自分で保てる角度にしてある（pose set kitakyushu-wood-l1-v1）
START_POSE_HOLD=true
# 2026-10-21 Kota の指示で、録画開始のシャッター音を大きくする（1.0 = 従来の音量、2.0 = 2 倍）。
# 他の通知音は変えない。音が割れるなら下げる
LEROBOT_SHUTTER_GAIN=2.0
