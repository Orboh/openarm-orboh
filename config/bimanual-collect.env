# 両腕収集のセッション既定値。scripts/collect_bimanual.sh が source する。
# ここに書くのは「収集期間中は固定・端末で毎回打ちたくない」値だけ。物理条件は scenes/<SCENE>.yaml。
# TODO を残したままだと collect_bimanual.sh は起動を拒否する（dry は SCENE=none で通る）。
OPERATOR=Kento
TASK="TODO: 学習時と rollout で一字一句同じ英文（例: Pick up the okra with both arms and place it in the bin）"
TASK_SLUG=TODO
SCENE=TODO                      # scenes/<name>.yaml（板橋用を新設して実測で TODO を埋める）
# カメラ（板橋・2026-09-21 実測: 新ハブ配下 USB3.0）
CHEST_SERIAL=344422070898       # D435i
WRIST_RIGHT_SERIAL=352122273417 # D405（ハブ Port 1）
WRIST_LEFT_SERIAL=409122272149  # D405（ハブ Port 3・2026-09-21 追加）
WRIST_LEFT=true                 # 左 wrist を録る（false にすると obs=chest_wristr の 2 眼データになる＝別モデル）
EPISODE_TIME_S=30
LSCALE=1.0
RSCALE=1.0
