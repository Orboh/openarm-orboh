# 両腕収集のセッション既定値。scripts/collect_bimanual.sh が source する。
# ここに書くのは「収集期間中は固定・端末で毎回打ちたくない」値だけ。物理条件は scenes/<SCENE>.yaml。
# TODO を残したままだと collect_bimanual.sh は起動を拒否する（dry は SCENE=none で通る）。
OPERATOR=Kota
TASK="Pick up an item from the pile and place it to the side"
TASK_SLUG=kitakyushu_takeei_sort
SCENE=kitakyushu-takeei-v1
# カメラ（北九州・2026-10-19 実測）
CHEST_SERIAL=344422070898       # D435i
WRIST_RIGHT_SERIAL=352122273417 # D405
WRIST_LEFT_SERIAL=409122272149  # D405
WRIST_LEFT=true                 # 左 wrist を録る（false にすると obs=chest_wristr の 2 眼データになる＝別モデル）
# 板橋の既定は D405_GAIN=空（自動露出）だが、北九州の白い机では実機確認で
# 自動露出だと白い梱包材が白飛びしたため手動値にしている（2026-10-19）。
# ⚠ 板橋の知見どおり、腕の向き次第で暗すぎ/明るすぎになるリスクが残る。
# dry/gate で複数姿勢を見て、問題があれば D405_GAIN= （空）に戻して自動へ。
D405_GAIN=16
D405_EXPOSURE=8000
# chest D435i も同様に自動露出+brightnessでは白飛びが解消しなかったため手動露出
D435_GAIN=64
D435_EXPOSURE=80
D435_BRIGHTNESS=
EPISODE_TIME_S=120
LSCALE=1.0
RSCALE=1.0
GRIPPER_KP=12
ALIGN_GRAVITY=false
# 2026-10-24: v2 は左手首（J6 19°）が下を向くので、11:45 にエディタで撮り直した v5（左 J6 -1.9°）を使う。
# 同日午前の sort dry 7 回は v5 で回していたが、この行が v2 のままで戻っていた。
POSE_SET=kitakyushu-takeei-v5
# アーム状態の音声読み上げ(spd-say, 日本語)。2026-10-19 実機で聞こえることを確認して有効化。
# 「エピソードN録画します」「アームを開始姿勢に戻してください」等をイベント発生時に読み上げる。
PLAY_SOUNDS=true
# 2026-10-24 Kota の指示で、起動時の整列・録画後の開始姿勢への戻し・終了時の戻しを 4 本同時に動かす
# （左右同時＝PARALLEL_ARMS、leader と follower 同時＝PARALLEL_LEADER_FOLLOWER）。
# 4 本の経路の干渉は確かめていないので、最初の dry で目視する。戻すときは両方 false
PARALLEL_ARMS=true
PARALLEL_LEADER_FOLLOWER=true
